{
  "name": "biblijeu",
  "productName": "Biblijeu",
  "version": "1.3.4",
  "description": "Bibliothèque de jeux : ROM, jeux Steam, jeux Windows avec Proton, émulateurs et sauvegardes",
  "author": "VGioM",
  "license": "UNLICENSED",
  "homepage": "https://github.com/VGioM/Biblijeu",
  "main": "src/main.js",
  "desktopName": "biblijeu.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "me.vgiom.biblijeu",
    "productName": "Biblijeu",
    "artifactName": "Biblijeu-${version}-linux-x86_64.${ext}",
    "files": [
      "src/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Game",
      "synopsis": "Bibliothèque de jeux et d'émulateurs",
      "syncDesktopName": true
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "44.11.1",
    "electron-builder": "26.18.0"
  }
}
